# Copia este archivo a ".env" y coloca tu propia API key (nunca subas el .env real al repositorio).

# API key de Nvidia Build (https://build.nvidia.com) -> tu perfil -> Get API Key
NVIDIA_API_KEY=tu_api_key_aqui

# Modelo a usar (catálogo de Nvidia Build). Puedes cambiarlo por cualquier modelo de chat disponible en tu cuenta.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
